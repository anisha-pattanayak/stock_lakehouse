# ============================================================
# Real-Time Stock Market Lakehouse Platform - Environment Config
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Stock Market API Keys ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
POLYGON_API_KEY=your_polygon_key_here

# --- Stock Symbols to Track (comma-separated) ---
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,V,JNJ

# --- Kafka ---
# IMPORTANT: Use port 29092 (internal PLAINTEXT listener) for container-to-container.
# Port 9092 is the PLAINTEXT_HOST listener bound to localhost on the host machine only.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_RAW=raw-stock-events
KAFKA_TOPIC_CLEANED=cleaned-stock-events
KAFKA_TOPIC_ANALYTICS=analytics-events
KAFKA_TOPIC_ALERTS=alerts-events
KAFKA_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=3

# --- Spark ---
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=StockLakehouseStreaming
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints

# --- Lakehouse Storage (Local for dev, S3 for prod) ---
LAKEHOUSE_BASE_PATH=/data/lakehouse
BRONZE_PATH=/data/lakehouse/bronze
SILVER_PATH=/data/lakehouse/silver
GOLD_PATH=/data/lakehouse/gold

# --- AWS (for production deployment) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-stock-lakehouse-bucket

# --- PostgreSQL (metadata store) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lakehouse_meta
POSTGRES_USER=lakehouse_user
POSTGRES_PASSWORD=lakehouse_pass

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://lakehouse_user:lakehouse_pass@postgres:5432/airflow_db
# Generate your own with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or use this safe default for local dev only (change in production):
AIRFLOW__CORE__FERNET_KEY=m_qMW1TeGbLeZu7RWguk2isdDT87DkPuIc1TDAkWLO0=
AIRFLOW_WEBSERVER_PORT=8080

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
SECRET_KEY=your_secret_key_here

# --- API Base URL (used by dashboard to call the API) ---
# Use service name inside Docker; use actual URL for external access
API_BASE_URL=http://api:8000

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- OpenAI (Optional AI features) ---
OPENAI_API_KEY=your_openai_key_here

# --- Ingestion ---
INGESTION_INTERVAL_SECONDS=10
API_PROVIDER=alpha_vantage
